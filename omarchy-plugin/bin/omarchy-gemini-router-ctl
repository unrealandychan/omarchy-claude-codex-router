#!/usr/bin/env python3
"""omarchy-gemini-router-ctl - Backend CLI for the Omarchy Gemini ADC Router plugin.

Manages:
1. Local Vertex AI Gemini ADC Router daemon (`claude-gemini-router.service` / uvicorn)
2. Claude Code (`~/.claude/settings.json`) routing to Gemini 3.8 Flash & Gemini 4.0 Argon
3. OpenAI Codex (`~/.codex/config.toml`) routing to Gemini 3.8 Flash & Gemini 4.0 Argon
4. Model & Reasoning Effort switching and ADC health inspection

All commands output structured JSON to stdout and exit 0 on handled errors
(with `{"error": "...", "ok": false}`) so Quickshell QML `Process` handlers
can always parse the response cleanly.
"""

from __future__ import annotations

import argparse
import errno
import json
import os
from pathlib import Path
import re
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from typing import Any
import urllib.error
import urllib.request

MAX_OUTPUT_BYTES = 1_048_576  # 1 MiB cap for subprocess output
VALID_TARGETS = ("claude", "codex", "both")
VALID_MODELS = ("gemini-3.8-flash", "gemini-4-argon")
VALID_EFFORTS = ("low", "medium", "high", "xhigh")

CODEX_BLOCK_BEGIN = "# BEGIN OMARCHY_GEMINI_ADC_ROUTER"
CODEX_BLOCK_END = "# END OMARCHY_GEMINI_ADC_ROUTER"

CLAUDE_MANAGED_ENV_KEYS = (
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL",
    "DISABLE_PROMPT_CACHING",
)


def _get_paths() -> dict[str, Path]:
    home = Path.home()
    config_dir = Path(
        os.environ.get(
            "OMARCHY_GEMINI_ROUTER_CONFIG_DIR",
            str(home / ".config" / "omarchy" / "gemini-router"),
        )
    )
    claude_settings = Path(
        os.environ.get(
            "CLAUDE_SETTINGS_PATH",
            str(home / ".claude" / "settings.json"),
        )
    )
    codex_config = Path(
        os.environ.get(
            "CODEX_CONFIG_PATH",
            str(home / ".codex" / "config.toml"),
        )
    )
    # Locate the router repository directory
    default_project_dir = home / "Projects" / "claude-gemini-adc-router"
    script_parent = Path(__file__).resolve().parent.parent.parent
    if (script_parent / "router" / "server.py").is_file():
        default_project_dir = script_parent
    project_dir = Path(
        os.environ.get("ROUTER_PROJECT_DIR", str(default_project_dir))
    )
    return {
        "config_dir": config_dir,
        "state_file": config_dir / "state.json",
        "env_file": config_dir / "router.env",
        "claude_settings": claude_settings,
        "codex_config": codex_config,
        "project_dir": project_dir,
    }


def _router_port() -> int:
    raw = os.environ.get("ROUTER_PORT", "4000")
    try:
        port = int(raw)
        return port if 1 <= port <= 65535 else 4000
    except ValueError:
        return 4000


def _router_url() -> str:
    return os.environ.get("ROUTER_URL", f"http://127.0.0.1:{_router_port()}").rstrip("/")


def write_file_safely(path: Path, content: str, mode: int = 0o600) -> None:
    """Safely write a file with O_NOFOLLOW, UID ownership verification, and atomic rename."""
    parent = path.parent
    parent.mkdir(parents=True, exist_ok=True)

    parent_stat = os.lstat(parent)
    if parent_stat.st_uid != os.getuid():
        raise PermissionError(f"Parent directory {parent} is not owned by current user")
    if stat.S_ISLNK(parent_stat.st_mode):
        raise PermissionError(f"Parent directory {parent} must not be a symlink")

    # Refuse writing if target exists and is a symlink
    try:
        target_stat = os.lstat(path)
        if stat.S_ISLNK(target_stat.st_mode):
            raise PermissionError(f"Refusing to write to symlink: {path}")
        if target_stat.st_uid != os.getuid():
            raise PermissionError(f"Target file {path} is not owned by current user")
    except FileNotFoundError:
        pass

    fd, tmp_path = tempfile.mkstemp(dir=str(parent), prefix=f".{path.name}.tmp.")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def read_file_safely(path: Path) -> str | None:
    """Read a UTF-8 file using O_NOFOLLOW, refusing symlinks or foreign-owned files."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(path), flags)
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise PermissionError(f"Refusing to read symlink: {path}") from exc
        raise

    try:
        st = os.fstat(fd)
        if st.st_uid != os.getuid():
            raise PermissionError(f"Refusing to read file not owned by current user: {path}")
        if st.st_size > MAX_OUTPUT_BYTES:
            raise ValueError(f"File exceeds size limit ({st.st_size} bytes): {path}")
        with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def run_cmd(args: list[str], timeout: float = 15.0) -> tuple[int, str, str]:
    """Run an external command without shell=True, with selector-based deadline & output caps."""
    env = os.environ.copy()
    home = str(Path.home())
    extra_paths = [
        f"{home}/.local/share/mise/shims",
        f"{home}/.local/bin",
        f"{home}/google-cloud-sdk/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
    ]
    env["PATH"] = ":".join(extra_paths + [env.get("PATH", "")])

    try:
        proc = subprocess.Popen(
            args,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            shell=False,
            env=env,
        )
    except FileNotFoundError:
        return 127, "", f"Executable not found: {args[0]}"
    except OSError as exc:
        return 1, "", str(exc)

    sel = selectors.DefaultSelector()
    assert proc.stdout is not None and proc.stderr is not None
    sel.register(proc.stdout, selectors.EVENT_READ, data="stdout")
    sel.register(proc.stderr, selectors.EVENT_READ, data="stderr")

    out_chunks: list[bytes] = []
    err_chunks: list[bytes] = []
    out_len = 0
    err_len = 0
    deadline = time.monotonic() + timeout
    timed_out = False

    try:
        while sel.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                proc.kill()
                break
            events = sel.select(timeout=min(remaining, 0.25))
            for key, _ in events:
                stream = key.fileobj
                chunk = os.read(stream.fileno(), 16384)  # type: ignore[union-attr]
                if not chunk:
                    sel.unregister(stream)
                    continue
                if key.data == "stdout":
                    if out_len < MAX_OUTPUT_BYTES:
                        take = chunk[: MAX_OUTPUT_BYTES - out_len]
                        out_chunks.append(take)
                        out_len += len(take)
                else:
                    if err_len < MAX_OUTPUT_BYTES:
                        take = chunk[: MAX_OUTPUT_BYTES - err_len]
                        err_chunks.append(take)
                        err_len += len(take)
        proc.wait(timeout=2.0)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        timed_out = True
    finally:
        sel.close()
        proc.stdout.close()
        proc.stderr.close()

    stdout_str = b"".join(out_chunks).decode("utf-8", errors="replace")
    stderr_str = b"".join(err_chunks).decode("utf-8", errors="replace")
    if timed_out:
        return 124, stdout_str, f"Command timed out after {timeout}s"
    return proc.returncode or 0, stdout_str, stderr_str


def load_state() -> dict[str, Any]:
    paths = _get_paths()
    raw = read_file_safely(paths["state_file"])
    default_state: dict[str, Any] = {
        "primary_model": "gemini-3.8-flash",
        "reasoning_effort": "medium",
        "claude_backup_env": None,
        "codex_backup": None,
    }
    if not raw:
        return default_state
    try:
        parsed = json.loads(raw)
        if isinstance(parsed, dict):
            return {**default_state, **parsed}
    except json.JSONDecodeError:
        pass
    return default_state


def save_state(state: dict[str, Any]) -> None:
    paths = _get_paths()
    write_file_safely(paths["state_file"], json.dumps(state, indent=2) + "\n", mode=0o600)
    # Also write router.env for systemd user service EnvironmentFile
    primary_model = state.get("primary_model", "gemini-3.8-flash")
    effort = state.get("reasoning_effort", "medium")
    env_content = (
        f"GEMINI_PRIMARY_MODEL={primary_model}\n"
        f"GEMINI_REASONING_EFFORT={effort}\n"
        f"ROUTER_PORT={_router_port()}\n"
    )
    write_file_safely(paths["env_file"], env_content, mode=0o600)


def normalize_model(model: str | None) -> str:
    if not model:
        return "gemini-3.8-flash"
    lowered = model.strip().lower()
    if "4" in lowered or "argon" in lowered or "pro" in lowered:
        return "gemini-4-argon"
    if lowered in VALID_MODELS:
        return lowered
    raise ValueError(f"Invalid model '{model}'. Allowed: {', '.join(VALID_MODELS)}")


def normalize_effort(effort: str | None) -> str:
    if not effort:
        return "medium"
    lowered = effort.strip().lower()
    if lowered in VALID_EFFORTS:
        return lowered
    raise ValueError(f"Invalid reasoning effort '{effort}'. Allowed: {', '.join(VALID_EFFORTS)}")


# ---------------------------------------------------------------------------
# Claude Code (`~/.claude/settings.json`) configuration helpers
# ---------------------------------------------------------------------------


def is_claude_routed() -> bool:
    paths = _get_paths()
    raw = read_file_safely(paths["claude_settings"])
    if not raw:
        return False
    try:
        data = json.loads(raw)
        env = data.get("env") or {}
        base_url = str(env.get("ANTHROPIC_BASE_URL", "")).rstrip("/")
        auth_token = str(env.get("ANTHROPIC_AUTH_TOKEN", ""))
        return base_url == _router_url() and auth_token == "adc-keyless"
    except Exception:
        return False


def configure_claude_routing(
    enable: bool,
    primary_model: str,
    state: dict[str, Any],
) -> None:
    paths = _get_paths()
    raw = read_file_safely(paths["claude_settings"])
    settings: dict[str, Any] = {}
    if raw:
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                settings = parsed
        except json.JSONDecodeError as exc:
            raise ValueError(f"Malformed JSON in {paths['claude_settings']}: {exc}") from exc

    current_env = settings.get("env")
    if not isinstance(current_env, dict):
        current_env = {}

    already_routed = (
        str(current_env.get("ANTHROPIC_BASE_URL", "")).rstrip("/") == _router_url()
        and str(current_env.get("ANTHROPIC_AUTH_TOKEN", "")) == "adc-keyless"
    )

    if enable:
        if not already_routed and state.get("claude_backup_env") is None:
            state["claude_backup_env"] = dict(current_env)

        # Start from backup env (if any) minus conflicting direct-Vertex / API key vars
        base_env = dict(state.get("claude_backup_env") or current_env)
        for conflict_key in (
            "CLAUDE_CODE_USE_VERTEX",
            "ANTHROPIC_API_KEY",
            "GEMINI_API_KEY",
            "GOOGLE_API_KEY",
        ):
            base_env.pop(conflict_key, None)

        base_env.update(
            {
                "ANTHROPIC_BASE_URL": _router_url(),
                "ANTHROPIC_AUTH_TOKEN": "adc-keyless",
                "ANTHROPIC_MODEL": primary_model,
                "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": primary_model,
                "ANTHROPIC_DEFAULT_OPUS_MODEL": primary_model,
                "DISABLE_PROMPT_CACHING": "1",
            }
        )
        settings["env"] = base_env
    else:
        backup_env = state.get("claude_backup_env")
        if isinstance(backup_env, dict):
            if backup_env:
                settings["env"] = dict(backup_env)
            else:
                settings.pop("env", None)
            state["claude_backup_env"] = None
        else:
            for k in CLAUDE_MANAGED_ENV_KEYS:
                current_env.pop(k, None)
            if current_env:
                settings["env"] = current_env
            else:
                settings.pop("env", None)

    write_file_safely(
        paths["claude_settings"],
        json.dumps(settings, indent=2) + "\n",
        mode=0o600,
    )


# ---------------------------------------------------------------------------
# OpenAI Codex (`~/.codex/config.toml`) configuration helpers
# ---------------------------------------------------------------------------


def _extract_top_level_toml_key(lines: list[str], key: str) -> str | None:
    """Extract a top-level `key = ...` line (before the first `[section]` header)."""
    pattern = re.compile(rf"^\s*{re.escape(key)}\s*=\s*(.+?)\s*$")
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and not stripped.startswith("[["):
            break
        m = pattern.match(line)
        if m:
            return line.rstrip("\n")
    return None


def _remove_top_level_toml_keys(lines: list[str], keys: tuple[str, ...]) -> list[str]:
    """Remove specified top-level keys (only before the first `[section]` header)."""
    result: list[str] = []
    in_top_level = True
    key_patterns = [re.compile(rf"^\s*{re.escape(k)}\s*=") for k in keys]
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            in_top_level = False
        if in_top_level and any(p.match(line) for p in key_patterns):
            continue
        result.append(line)
    return result


def _strip_codex_managed_block(text: str) -> str:
    """Remove `# BEGIN OMARCHY_GEMINI_ADC_ROUTER ... # END OMARCHY_GEMINI_ADC_ROUTER` block."""
    pattern = re.compile(
        rf"\n?{re.escape(CODEX_BLOCK_BEGIN)}.*?{re.escape(CODEX_BLOCK_END)}\n?",
        re.DOTALL,
    )
    return pattern.sub("\n", text)


def is_codex_routed() -> bool:
    paths = _get_paths()
    raw = read_file_safely(paths["codex_config"])
    if not raw:
        return False
    has_provider = bool(
        re.search(r'^\s*model_provider\s*=\s*"gemini_adc"', raw, re.MULTILINE)
    )
    has_section = "[model_providers.gemini_adc]" in raw
    return has_provider and has_section


def configure_codex_routing(
    enable: bool,
    primary_model: str,
    reasoning_effort: str,
    state: dict[str, Any],
) -> None:
    paths = _get_paths()
    raw = read_file_safely(paths["codex_config"]) or ""
    already_routed = is_codex_routed()

    cleaned = _strip_codex_managed_block(raw)
    lines = cleaned.splitlines()

    if enable:
        if not already_routed and state.get("codex_backup") is None:
            state["codex_backup"] = {
                "model_provider": _extract_top_level_toml_key(lines, "model_provider"),
                "model": _extract_top_level_toml_key(lines, "model"),
                "model_reasoning_effort": _extract_top_level_toml_key(
                    lines, "model_reasoning_effort"
                ),
            }

        lines = _remove_top_level_toml_keys(
            lines, ("model_provider", "model", "model_reasoning_effort")
        )
        header_lines = [
            'model_provider = "gemini_adc"',
            f'model = "{primary_model}"',
            f'model_reasoning_effort = "{reasoning_effort}"',
        ]
        # Strip leading blank lines from remaining body
        while lines and not lines[0].strip():
            lines.pop(0)

        managed_block = [
            CODEX_BLOCK_BEGIN,
            "[model_providers.gemini_adc]",
            'name = "Gemini ADC Router (Vertex AI)"',
            f'base_url = "{_router_url()}/v1"',
            'wire_api = "responses"',
            CODEX_BLOCK_END,
        ]

        body = "\n".join(header_lines + ([""] if lines else []) + lines).rstrip()
        full_text = body + "\n\n" + "\n".join(managed_block) + "\n"
        write_file_safely(paths["codex_config"], full_text, mode=0o600)
    else:
        lines = _remove_top_level_toml_keys(
            lines, ("model_provider", "model", "model_reasoning_effort")
        )
        backup = state.get("codex_backup")
        restored_top: list[str] = []
        if isinstance(backup, dict):
            for k in ("model_provider", "model", "model_reasoning_effort"):
                val = backup.get(k)
                if isinstance(val, str) and val.strip():
                    restored_top.append(val)
            state["codex_backup"] = None

        while lines and not lines[0].strip():
            lines.pop(0)

        combined = restored_top + ([""] if restored_top and lines else []) + lines
        full_text = "\n".join(combined).strip()
        if full_text:
            full_text += "\n"
        write_file_safely(paths["codex_config"], full_text, mode=0o600)


# ---------------------------------------------------------------------------
# Router Daemon & Health Checks
# ---------------------------------------------------------------------------


def _urlopen_local(req: urllib.request.Request, timeout: float):
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    return opener.open(req, timeout=timeout)


def fetch_router_health(timeout: float = 1.5) -> dict[str, Any] | None:
    url = f"{_router_url()}/health"
    req = urllib.request.Request(url, method="GET")
    try:
        with _urlopen_local(req, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8", errors="replace"))
    except Exception:
        return None
    return None


def push_router_config(
    primary_model: str,
    reasoning_effort: str,
    hot_swap: bool = True,
) -> bool:
    url = f"{_router_url()}/config"
    payload = json.dumps(
        {
            "primary_model": primary_model,
            "reasoning_effort": reasoning_effort,
            "hot_swap": hot_swap,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with _urlopen_local(req, timeout=2.0) as resp:
            return resp.status == 200
    except Exception:
        return False


def is_systemd_service_enabled() -> bool:
    rc, out, _ = run_cmd(
        ["systemctl", "--user", "is-enabled", "claude-gemini-router.service"],
        timeout=3.0,
    )
    return rc == 0 and "enabled" in out.strip()


def is_systemd_service_active() -> bool:
    rc, out, _ = run_cmd(
        ["systemctl", "--user", "is-active", "claude-gemini-router.service"],
        timeout=3.0,
    )
    return rc == 0 and out.strip() == "active"


def start_router_daemon(state: dict[str, Any]) -> tuple[bool, str]:
    """Ensure the local ADC router is running on `_router_port()`."""
    if os.environ.get("OMARCHY_GEMINI_ROUTER_MOCK_DAEMON") == "1":
        return True, "mock-daemon-started"

    health = fetch_router_health(timeout=1.0)
    if health and health.get("status") == "ok":
        push_router_config(state["primary_model"], state["reasoning_effort"])
        return True, "already-running"

    # Try systemd user service first
    rc, _, _ = run_cmd(
        ["systemctl", "--user", "start", "claude-gemini-router.service"],
        timeout=5.0,
    )
    if rc == 0:
        for _ in range(20):
            if fetch_router_health(timeout=0.5):
                push_router_config(state["primary_model"], state["reasoning_effort"])
                return True, "systemd"
            time.sleep(0.2)

    # Fallback: spawn router directly using repository .venv/bin/python
    paths = _get_paths()
    project_dir = paths["project_dir"]
    venv_python = project_dir / ".venv" / "bin" / "python"
    if not venv_python.is_file():
        return False, f"Router virtualenv not found at {venv_python}"

    env = os.environ.copy()
    env["GEMINI_PRIMARY_MODEL"] = state["primary_model"]
    env["GEMINI_REASONING_EFFORT"] = state["reasoning_effort"]
    env["ROUTER_PORT"] = str(_router_port())

    log_path = paths["config_dir"] / "router.log"
    paths["config_dir"].mkdir(parents=True, exist_ok=True)
    log_fd = os.open(
        str(log_path),
        os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        subprocess.Popen(
            [
                str(venv_python),
                "-m",
                "router.server",
                "--host",
                "127.0.0.1",
                "--port",
                str(_router_port()),
            ],
            cwd=str(project_dir),
            stdin=subprocess.DEVNULL,
            stdout=log_fd,
            stderr=log_fd,
            start_new_session=True,
            env=env,
        )
    finally:
        os.close(log_fd)

    for _ in range(25):
        if fetch_router_health(timeout=0.5):
            push_router_config(state["primary_model"], state["reasoning_effort"])
            return True, "background-process"
        time.sleep(0.2)

    return False, "Router failed to respond on /health within timeout"


def stop_router_daemon() -> tuple[bool, str]:
    if os.environ.get("OMARCHY_GEMINI_ROUTER_MOCK_DAEMON") == "1":
        return True, "mock-daemon-stopped"

    run_cmd(["systemctl", "--user", "stop", "claude-gemini-router.service"], timeout=5.0)
    # Also terminate any standalone router.server process for this user on this port
    port_str = str(_router_port())
    rc, out, _ = run_cmd(["pgrep", "-u", str(os.getuid()), "-f", "router.server"], timeout=3.0)
    if rc == 0 and out.strip():
        for line in out.strip().splitlines():
            try:
                pid = int(line.strip())
                if pid != os.getpid():
                    os.kill(pid, signal.SIGTERM)
            except (ValueError, ProcessLookupError, PermissionError):
                pass
    for _ in range(10):
        if not fetch_router_health(timeout=0.4):
            return True, "stopped"
        time.sleep(0.2)
    return False, "Router is still responding after stop attempt"


def probe_adc_status_offline() -> dict[str, Any]:
    """Check ADC file and gcloud config quickly when the router daemon is stopped."""
    adc_file = Path(
        os.environ.get(
            "GOOGLE_APPLICATION_CREDENTIALS",
            str(Path.home() / ".config" / "gcloud" / "application_default_credentials.json"),
        )
    )
    has_adc_file = adc_file.is_file()
    project_id = (
        os.environ.get("GOOGLE_CLOUD_PROJECT")
        or os.environ.get("ANTHROPIC_VERTEX_PROJECT_ID")
        or ""
    )
    if not project_id:
        gcloud_cfg = Path.home() / ".config" / "gcloud" / "configurations" / "config_default"
        raw_cfg = read_file_safely(gcloud_cfg) if gcloud_cfg.is_file() else None
        if raw_cfg:
            m = re.search(r"^\s*project\s*=\s*(.+?)\s*$", raw_cfg, re.MULTILINE)
            if m:
                project_id = m.group(1).strip()
    return {
        "adc_mode": True,
        "api_key_used": False,
        "credentials_type": "UserCredentials" if has_adc_file else None,
        "project_id": project_id or "unknown",
        "location": os.environ.get("GOOGLE_CLOUD_LOCATION", "global"),
        "token_valid": has_adc_file,
        "error": None if has_adc_file else "ADC credentials file not found",
    }


def build_status_dict() -> dict[str, Any]:
    state = load_state()
    health = fetch_router_health(timeout=1.5)
    router_running = bool(health and health.get("status") == "ok")
    if os.environ.get("OMARCHY_GEMINI_ROUTER_MOCK_DAEMON") == "1":
        router_running = bool(state.get("mock_router_running", True))
    elif not router_running:
        router_running = is_systemd_service_active()

    default_stats = {
        "total_requests": 0,
        "claude_requests": 0,
        "codex_requests": 0,
        "chat_requests": 0,
        "input_tokens": 0,
        "output_tokens": 0,
        "reasoning_tokens": 0,
        "cached_tokens": 0,
        "total_tokens": 0,
        "fallback_count": 0,
        "error_count": 0,
        "last_client": None,
        "last_requested_model": None,
        "last_vertex_model": None,
        "last_latency_ms": None,
        "last_request_at": None,
    }
    if health and isinstance(health.get("adc"), dict):
        adc_info = health["adc"]
        primary_model = str(health.get("primary_model") or state["primary_model"])
        reasoning_effort = str(health.get("reasoning_effort") or state["reasoning_effort"])
        hot_swap_active = bool(health.get("hot_swap_active", False))
        raw_stats = health.get("stats")
        stats_info = (
            {**default_stats, **raw_stats}
            if isinstance(raw_stats, dict)
            else default_stats
        )
    else:
        adc_info = probe_adc_status_offline()
        primary_model = state["primary_model"]
        reasoning_effort = state["reasoning_effort"]
        hot_swap_active = False
        stats_info = default_stats

    claude_on = is_claude_routed()
    codex_on = is_codex_routed()

    short_model = "Gemini 4.0" if "4" in primary_model else "Gemini 3.8"
    if claude_on and codex_on:
        status_label = f"Claude + Codex -> {short_model}"
        badge_text = "C+X -> G4" if "4" in primary_model else "C+X -> G3.8"
    elif claude_on:
        status_label = f"Claude -> {short_model}"
        badge_text = "Claude -> G4" if "4" in primary_model else "Claude -> G3.8"
    elif codex_on:
        status_label = f"Codex -> {short_model}"
        badge_text = "Codex -> G4" if "4" in primary_model else "Codex -> G3.8"
    else:
        status_label = "Direct (Routing Off)"
        badge_text = "ADC Off"

    home = str(Path.home())
    search_path = ":".join(
        [
            f"{home}/.local/share/mise/shims",
            f"{home}/.local/bin",
            os.environ.get("PATH", ""),
        ]
    )

    return {
        "ok": True,
        "router_running": router_running,
        "service_enabled": is_systemd_service_enabled(),
        "router_url": _router_url(),
        "router_port": _router_port(),
        "claude_enabled": claude_on,
        "codex_enabled": codex_on,
        "any_enabled": claude_on or codex_on,
        "both_enabled": claude_on and codex_on,
        "claude_installed": shutil.which("claude", path=search_path) is not None,
        "codex_installed": shutil.which("codex", path=search_path) is not None,
        "primary_model": primary_model,
        "reasoning_effort": reasoning_effort,
        "hot_swap_active": hot_swap_active,
        "status_label": status_label,
        "badge_text": badge_text,
        "adc": adc_info,
        "stats": stats_info,
    }


# ---------------------------------------------------------------------------
# Subcommand Handlers
# ---------------------------------------------------------------------------


def cmd_status(_args: argparse.Namespace) -> dict[str, Any]:
    return build_status_dict()


def cmd_enable(args: argparse.Namespace) -> dict[str, Any]:
    target = args.target
    if target not in VALID_TARGETS:
        raise ValueError(f"Invalid target '{target}'. Must be one of {VALID_TARGETS}")

    state = load_state()
    if args.model:
        state["primary_model"] = normalize_model(args.model)
    if args.effort:
        state["reasoning_effort"] = normalize_effort(args.effort)

    if target in ("claude", "both"):
        configure_claude_routing(True, state["primary_model"], state)
    if target in ("codex", "both"):
        configure_codex_routing(
            True, state["primary_model"], state["reasoning_effort"], state
        )

    save_state(state)
    state["mock_router_running"] = True
    save_state(state)
    started, mode = start_router_daemon(state)
    res = build_status_dict()
    res["daemon_mode"] = mode
    if not started:
        res["warning"] = f"Routing config enabled, but router daemon reported: {mode}"
    return res


def cmd_disable(args: argparse.Namespace) -> dict[str, Any]:
    target = args.target
    if target not in VALID_TARGETS:
        raise ValueError(f"Invalid target '{target}'. Must be one of {VALID_TARGETS}")

    state = load_state()
    if target in ("claude", "both"):
        configure_claude_routing(False, state["primary_model"], state)
    if target in ("codex", "both"):
        configure_codex_routing(
            False, state["primary_model"], state["reasoning_effort"], state
        )
    save_state(state)
    return build_status_dict()


def cmd_toggle(args: argparse.Namespace) -> dict[str, Any]:
    target = args.target
    if target not in VALID_TARGETS:
        raise ValueError(f"Invalid target '{target}'. Must be one of {VALID_TARGETS}")

    claude_on = is_claude_routed()
    codex_on = is_codex_routed()

    if target == "claude":
        enable = not claude_on
    elif target == "codex":
        enable = not codex_on
    else:
        enable = not (claude_on and codex_on)

    ns = argparse.Namespace(target=target, model=None, effort=None)
    return cmd_enable(ns) if enable else cmd_disable(ns)


def cmd_set_model(args: argparse.Namespace) -> dict[str, Any]:
    state = load_state()
    if getattr(args, "flip", False):
        current = str(state.get("primary_model", "gemini-3.8-flash"))
        state["primary_model"] = (
            "gemini-3.8-flash" if "4" in current else "gemini-4-argon"
        )
    elif args.model:
        state["primary_model"] = normalize_model(args.model)
    if args.effort:
        state["reasoning_effort"] = normalize_effort(args.effort)

    if is_claude_routed():
        configure_claude_routing(True, state["primary_model"], state)
    if is_codex_routed():
        configure_codex_routing(
            True, state["primary_model"], state["reasoning_effort"], state
        )

    save_state(state)
    push_router_config(state["primary_model"], state["reasoning_effort"], hot_swap=True)
    return build_status_dict()


def cmd_start_router(_args: argparse.Namespace) -> dict[str, Any]:
    state = load_state()
    state["mock_router_running"] = True
    save_state(state)
    ok, detail = start_router_daemon(state)
    res = build_status_dict()
    res["ok"] = ok
    res["detail"] = detail
    if not ok:
        res["error"] = detail
    return res


def cmd_stop_router(_args: argparse.Namespace) -> dict[str, Any]:
    state = load_state()
    state["mock_router_running"] = False
    save_state(state)
    ok, detail = stop_router_daemon()
    res = build_status_dict()
    res["ok"] = ok
    res["detail"] = detail
    return res


def cmd_restart_router(_args: argparse.Namespace) -> dict[str, Any]:
    stop_router_daemon()
    state = load_state()
    state["mock_router_running"] = True
    save_state(state)
    ok, detail = start_router_daemon(state)
    res = build_status_dict()
    res["ok"] = ok
    res["detail"] = detail
    return res


def cmd_logs(args: argparse.Namespace) -> dict[str, Any]:
    lines = max(1, min(500, int(args.lines)))
    paths = _get_paths()
    log_file = paths["config_dir"] / "router.log"
    entries: list[str] = []

    rc, out, _ = run_cmd(
        [
            "journalctl",
            "--user",
            "-u",
            "claude-gemini-router.service",
            "-n",
            str(lines),
            "--no-pager",
        ],
        timeout=5.0,
    )
    if rc == 0 and out.strip() and "-- No entries --" not in out:
        entries = out.strip().splitlines()[-lines:]
    elif log_file.is_file():
        raw = read_file_safely(log_file) or ""
        entries = raw.strip().splitlines()[-lines:]

    return {
        "ok": True,
        "lines": entries,
        "text": "\n".join(entries) if entries else "No router log entries yet.",
    }


def cmd_adc_login(_args: argparse.Namespace) -> dict[str, Any]:
    """Launch interactive `gcloud auth application-default login` in the user's terminal."""
    for term_cmd in (
        ["uwsm-app", "--", "xdg-terminal-exec", "gcloud", "auth", "application-default", "login"],
        ["xdg-terminal-exec", "gcloud", "auth", "application-default", "login"],
        ["kitty", "-e", "gcloud", "auth", "application-default", "login"],
        ["alacritty", "-e", "gcloud", "auth", "application-default", "login"],
    ):
        exe = term_cmd[0]
        if shutil.which(exe):
            subprocess.Popen(
                term_cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return {
                "ok": True,
                "launched": True,
                "command": " ".join(term_cmd),
            }
    return {
        "ok": False,
        "launched": False,
        "error": "No terminal emulator found. Run: gcloud auth application-default login",
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omarchy-gemini-router-ctl",
        description="Control Claude Code & OpenAI Codex routing to Vertex AI Gemini via ADC",
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    sub.add_parser("status", help="Output full router, ADC, Claude, and Codex routing status as JSON")

    p_enable = sub.add_parser("enable", help="Enable Gemini ADC routing for Claude, Codex, or both")
    p_enable.add_argument("--target", default="both", help="Target client: claude, codex, or both")
    p_enable.add_argument("--model", default=None, help="Primary Gemini model (gemini-3.8-flash or gemini-4-argon)")
    p_enable.add_argument("--effort", default=None, help="Reasoning effort (low, medium, high, xhigh)")

    p_disable = sub.add_parser("disable", help="Disable Gemini ADC routing and restore previous config")
    p_disable.add_argument("--target", default="both", help="Target client: claude, codex, or both")

    p_toggle = sub.add_parser("toggle", help="Toggle Gemini ADC routing for Claude, Codex, or both")
    p_toggle.add_argument("--target", default="both", help="Target client: claude, codex, or both")

    p_model = sub.add_parser("set-model", help="Set active Gemini model and reasoning effort")
    p_model.add_argument("--model", default=None, help="Model: gemini-3.8-flash or gemini-4-argon")
    p_model.add_argument("--effort", default=None, help="Reasoning effort: low, medium, high, xhigh")
    p_model.add_argument("--flip", action="store_true", help="Flip active model between 3.8 Flash and 4.0 Argon")

    sub.add_parser("start-router", help="Start the local Vertex AI Gemini ADC router service")
    sub.add_parser("stop-router", help="Stop the local Vertex AI Gemini ADC router service")
    sub.add_parser("restart-router", help="Restart the local Vertex AI Gemini ADC router service")

    p_logs = sub.add_parser("logs", help="Fetch recent router logs")
    p_logs.add_argument("--lines", type=int, default=40, help="Number of log lines (1-500)")

    sub.add_parser("adc-login", help="Launch gcloud auth application-default login in a terminal")
    return parser


def main() -> int:
    parser = build_parser()
    try:
        args = parser.parse_args()
        dispatch = {
            "status": cmd_status,
            "enable": cmd_enable,
            "disable": cmd_disable,
            "toggle": cmd_toggle,
            "set-model": cmd_set_model,
            "start-router": cmd_start_router,
            "stop-router": cmd_stop_router,
            "restart-router": cmd_restart_router,
            "logs": cmd_logs,
            "adc-login": cmd_adc_login,
        }
        result = dispatch[args.subcommand](args)
        print(json.dumps(result))
        return 0
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 0


if __name__ == "__main__":
    sys.exit(main())
