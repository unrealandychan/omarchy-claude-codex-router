#!/usr/bin/env bash
# Keyless (ADC-only) launcher for Claude Code routed to Gemini 3.8 & Gemini 4.0 (macOS & Linux)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROUTER_ENV_FILE="${HOME}/.config/omarchy/gemini-router/router.env"
if [[ ! -f "${ROUTER_ENV_FILE}" && -f "${HOME}/.config/gemini-router/router.env" ]]; then
  ROUTER_ENV_FILE="${HOME}/.config/gemini-router/router.env"
fi

read_env_key() {
  local key="$1"
  local file="$2"
  if [[ -f "$file" && ! -L "$file" ]]; then
    awk -F= -v k="$key" '$1 == k { sub(/^[^=]*=/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }' "$file"
  fi
}

if [[ -z "${ROUTER_PORT:-}" ]]; then
  ROUTER_PORT="$(read_env_key "ROUTER_PORT" "${ROUTER_ENV_FILE}")"
fi
ROUTER_PORT="${ROUTER_PORT:-4000}"
ROUTER_URL="http://127.0.0.1:${ROUTER_PORT}"

if [[ -z "${GEMINI_PRIMARY_MODEL:-}" ]]; then
  GEMINI_PRIMARY_MODEL="$(read_env_key "GEMINI_PRIMARY_MODEL" "${ROUTER_ENV_FILE}")"
fi
PRIMARY_MODEL="${GEMINI_PRIMARY_MODEL:-gemini-3.8-flash}"
PRINT_ENV_ONLY=false
START_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --3.8|--flash)
      PRIMARY_MODEL="gemini-3.8-flash"
      shift
      ;;
    --4.0|--argon|--pro)
      PRIMARY_MODEL="gemini-4-argon"
      shift
      ;;
    --model)
      if [[ $# -ge 2 ]]; then
        PRIMARY_MODEL="$2"
        shift 2
      else
        shift
      fi
      ;;
    --model=*)
      PRIMARY_MODEL="${1#*=}"
      shift
      ;;
    --env)
      PRINT_ENV_ONLY=true
      shift
      ;;
    --serve)
      START_ONLY=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ "${PRINT_ENV_ONLY}" == "true" ]]; then
  cat <<EOF
unset ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY CLAUDE_CODE_USE_VERTEX DISABLE_PROMPT_CACHING DISABLE_PROMPT_CACHING_HAIKU DISABLE_PROMPT_CACHING_SONNET DISABLE_PROMPT_CACHING_OPUS
export ANTHROPIC_BASE_URL="${ROUTER_URL}"
export ANTHROPIC_AUTH_TOKEN="adc-keyless"
export ANTHROPIC_MODEL="${PRIMARY_MODEL}"
export ANTHROPIC_SMALL_FAST_MODEL="claude-haiku-4-5"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${PRIMARY_MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${PRIMARY_MODEL}"
EOF
  exit 0
fi

export PATH="${HOME}/.cargo/bin:${HOME}/.local/share/mise/shims:${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${HOME}/google-cloud-sdk/bin:${PATH}"

resolve_router_bin() {
  if [[ -x "${PROJECT_DIR}/target/release/claude-gemini-router" ]]; then
    echo "${PROJECT_DIR}/target/release/claude-gemini-router"
  elif command -v claude-gemini-router >/dev/null 2>&1; then
    command -v claude-gemini-router
  elif [[ -x "${HOME}/.local/bin/claude-gemini-router" ]]; then
    echo "${HOME}/.local/bin/claude-gemini-router"
  else
    (cd "${PROJECT_DIR}" && cargo build --release --locked >&2)
    echo "${PROJECT_DIR}/target/release/claude-gemini-router"
  fi
}

resolve_ctl_bin() {
  if [[ -x "${PROJECT_DIR}/target/release/omarchy-gemini-router-ctl" ]]; then
    echo "${PROJECT_DIR}/target/release/omarchy-gemini-router-ctl"
  elif command -v omarchy-gemini-router-ctl >/dev/null 2>&1; then
    command -v omarchy-gemini-router-ctl
  elif [[ -x "${HOME}/.local/bin/omarchy-gemini-router-ctl" ]]; then
    echo "${HOME}/.local/bin/omarchy-gemini-router-ctl"
  else
    (cd "${PROJECT_DIR}" && cargo build --release --locked >&2)
    echo "${PROJECT_DIR}/target/release/omarchy-gemini-router-ctl"
  fi
}

if [[ "${START_ONLY}" == "true" ]]; then
  ROUTER_BIN="$(resolve_router_bin)"
  exec "${ROUTER_BIN}" --port "${ROUTER_PORT}" "$@"
fi

# Ensure router is running in the background
export NO_PROXY="127.0.0.1,localhost,${NO_PROXY:-}"
export no_proxy="127.0.0.1,localhost,${no_proxy:-}"
if [[ -x "$(resolve_ctl_bin 2>/dev/null || true)" ]]; then
  CTL_BIN="$(resolve_ctl_bin)"
  "${CTL_BIN}" start-router >/dev/null 2>&1 || true
fi
if ! curl --noproxy '*' -fsS "${ROUTER_URL}/health" >/dev/null 2>&1; then
  echo "[claude-gemini] Starting Rust ADC router on ${ROUTER_URL}..." >&2
  ROUTER_BIN="$(resolve_router_bin)"
  (
    cd "${PROJECT_DIR}"
    nohup "${ROUTER_BIN}" --port "${ROUTER_PORT}" \
      >/tmp/claude-gemini-router.log 2>&1 &
  )
  for _ in {1..30}; do
    if curl --noproxy '*' -fsS "${ROUTER_URL}/health" >/dev/null 2>&1; then
      break
    fi
    sleep 0.2
  done
fi

unset ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY DISABLE_PROMPT_CACHING DISABLE_PROMPT_CACHING_HAIKU DISABLE_PROMPT_CACHING_SONNET DISABLE_PROMPT_CACHING_OPUS
export CLAUDE_CODE_USE_VERTEX=0
export ANTHROPIC_BASE_URL="${ROUTER_URL}"
export ANTHROPIC_AUTH_TOKEN="adc-keyless"
export ANTHROPIC_MODEL="${PRIMARY_MODEL}[1m]"
export ANTHROPIC_SMALL_FAST_MODEL="claude-haiku-4-5"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${PRIMARY_MODEL}[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${PRIMARY_MODEL}[1m]"

SETTINGS_OVERRIDE="{\"model\":\"${PRIMARY_MODEL}[1m]\",\"env\":{\"CLAUDE_CODE_USE_VERTEX\":\"0\",\"ANTHROPIC_BASE_URL\":\"${ROUTER_URL}\",\"ANTHROPIC_AUTH_TOKEN\":\"adc-keyless\",\"ANTHROPIC_MODEL\":\"${PRIMARY_MODEL}[1m]\",\"ANTHROPIC_SMALL_FAST_MODEL\":\"claude-haiku-4-5\",\"ANTHROPIC_DEFAULT_HAIKU_MODEL\":\"claude-haiku-4-5\",\"ANTHROPIC_DEFAULT_SONNET_MODEL\":\"${PRIMARY_MODEL}[1m]\",\"ANTHROPIC_DEFAULT_OPUS_MODEL\":\"${PRIMARY_MODEL}[1m]\"}}"

if command -v claude >/dev/null 2>&1; then
  exec claude --settings "${SETTINGS_OVERRIDE}" "$@"
else
  echo "[claude-gemini] Router is live at ${ROUTER_URL} (model=${PRIMARY_MODEL})." >&2
  echo "[claude-gemini] 'claude' CLI not found on PATH. Run: eval \"\$(${SCRIPT_DIR}/claude-gemini --env)\"" >&2
fi
